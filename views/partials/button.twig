{# views/partials/button.twig
   Bouton aligné sur le kit Onzehonze.
   Variantes : 'filled' (corail foncé → nuit) ou 'outline' (papier + bordure nuit).
   Usage : {% include 'partials/button.twig' with { cta: f.cta_primary, variant: 'filled' } %}
   cta = groupe cloné group_cta (cta_text + cta_link).
#}
{% set variant = variant|default('filled') %}
{% set link = cta.cta_link ?? null %}
{% set href = link is iterable ? (link.url ?? null) : (link ?? null) %}
{% set target = link is iterable ? (link.target ?? null) : null %}

{% if cta and cta.cta_text %}
  {% set base = 'group inline-flex items-center justify-center gap-2.5 rounded-[0.55rem] min-h-[3.35rem] px-6 py-3 text-[0.95rem] font-bold transition-all duration-200 hover:-translate-y-0.5' %}
  {% set skin = variant == 'outline'
      ? 'bg-brand-paper/70 border border-brand-nuit/30 text-brand-nuit hover:border-brand-nuit/50'
      : 'bg-brand-rouge-fonce text-white hover:bg-brand-nuit' %}

  <a href="{{ href ?? '#' }}"
     class="{{ base }} {{ skin }}"
     {% if target == '_blank' %}target="_blank" rel="noopener noreferrer"{% endif %}>
    <span>{{ cta.cta_text }}</span>
    <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
{% endif %}
