{# views/blocks/faq.twig
   FAQ : en-tête à gauche + accordéon (questions/réponses) à droite.
   Accordéon natif <details>/<summary> — aucun JS requis. Contenu repris du kit Conseil.
#}
{% set f = fields ?? {} %}
{% set bg_color = f.bg_color|default('#ffffff') %}

<section id="{{ block.anchor ?? block_id }}"
         class="relative {{ block_classes }}"
         style="background-color: {{ bg_color }};">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16">

      {# En-tête (1/3) #}
      <div class="lg:col-span-1 js-reveal" data-reveal-from="left">
        {% if f.eyebrow %}
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-rouge mb-4">{{ f.eyebrow }}</p>
        {% endif %}
        {% if f.title %}
          <h2 class="text-3xl md:text-4xl font-semibold leading-tight text-brand-nuit">{{ f.title }}</h2>
        {% endif %}
        {% if f.intro %}
          <p class="mt-4 text-brand-text">{{ f.intro }}</p>
        {% endif %}
      </div>

      {# Accordéon (2/3) #}
      {% if f.items %}
        <div class="lg:col-span-2 divide-y divide-neutral-200 border-t border-neutral-200 js-reveal"
             data-reveal-from="right" data-reveal-delay="0.05">
          {% for item in f.items %}
            <details class="faq-item py-5" {{ loop.first ? 'open' : '' }}>
              <summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-brand-nuit">
                <span>{{ item.question }}</span>
                <svg class="faq-icon w-5 h-5 text-brand-rouge shrink-0 transition-transform duration-200"
                     viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </summary>
              {% if item.answer %}
                <p class="mt-3 text-sm text-brand-text leading-relaxed">{{ item.answer }}</p>
              {% endif %}
            </details>
          {% endfor %}
        </div>
      {% endif %}

    </div>
  </div>
</section>
