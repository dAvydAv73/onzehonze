{# views/blocks/situations.twig
   Bande « situations » fidèle au kit : fond orange, en-tête titre à gauche /
   intro à droite, puis liste 3 colonnes séparées par des filets, chaque colonne
   avec un numéro corail, un titre et un texte.
#}
{% set f = fields ?? {} %}
{% set bg_color = f.bg_color|default('#F7B449') %}
{% set divider = 'rgba(24,36,46,.28)' %}

<section id="{{ block.anchor ?? block_id }}"
         class="relative {{ block_classes }} text-brand-nuit"
         style="background-color: {{ bg_color }};">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-20 md:py-28">

    {# En-tête : eyebrow pleine largeur, puis titre (gauche) + intro (droite) #}
    <div class="mb-12 md:mb-16">
      {% if f.eyebrow %}
        <p class="onze-eyebrow mb-6 js-reveal" style="color:#8a3025;" data-reveal-from="up">{{ f.eyebrow }}</p>
      {% endif %}
      <div class="grid grid-cols-1 lg:grid-cols-[0.86fr_1.14fr] gap-6 lg:gap-16 items-start">
        {% if f.title %}
          <h2 class="font-display text-3xl md:text-4xl lg:text-5xl max-w-[15ch] js-reveal"
              data-reveal-from="up" data-reveal-delay="0.05">{{ f.title }}</h2>
        {% endif %}
        {% if f.intro %}
          <p class="text-lg leading-relaxed max-w-2xl lg:pt-2 js-reveal"
             data-reveal-from="up" data-reveal-delay="0.1">{{ f.intro }}</p>
        {% endif %}
      </div>
    </div>

    {# Liste 3 colonnes à filets #}
    {% if f.items %}
      <div class="grid grid-cols-1 md:grid-cols-3" style="border-top:1px solid {{ divider }};">
        {% for item in f.items %}
          <article class="grid grid-cols-[auto_1fr] gap-5 py-10 md:pr-8 js-reveal
                          {{ not loop.first ? 'md:pl-8' : '' }}"
                   style="{% if not loop.last %}border-right:1px solid {{ divider }};{% endif %}"
                   data-reveal-from="up" data-reveal-delay="{{ (loop.index0 * 0.08)|round(2) }}">
            <span class="font-display text-sm font-extrabold" style="color:#A94332;">{{ '%02d'|format(loop.index) }}</span>
            <div>
              {% if item.title %}
                <h3 class="font-display text-xl md:text-2xl leading-tight">{{ item.title }}</h3>
              {% endif %}
              {% if item.text %}
                <p class="mt-3 text-brand-text leading-relaxed">{{ item.text }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>
